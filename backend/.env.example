# Environment variables for local development

# Database
DATABASE_URL=postgresql://underwriting_user:underwriting_pass@localhost:5432/underwriting_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LLM APIs
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Application
APP_NAME=Underwriting Agent
DEBUG=True
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Security
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Feature Management
ENABLE_ROUTER=true
ENABLE_RAG=false
ROUTER_COST_OPTIMIZATION=true
ROUTER_LATENCY_OPTIMIZATION=true
DEFAULT_MODEL_THRESHOLD=0.7
USE_RAG_THRESHOLD=0.6

# Bandit
BANDIT_ALGORITHM=linucb
BANDIT_EXPLORATION_RATE=0.1
BANDIT_UPDATE_FREQUENCY=100

# Simulation
SIMULATION_MODE=false
SIMULATION_DATA_SIZE=1000
